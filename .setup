#!/bin/bash
# Bootstrap a new machine: install nix, activate the home-manager flake
# configuration for this host, and switch the login shell to zsh.

set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
conf="$("$repo/hm_config_name")"
nix_args=(--extra-experimental-features 'nix-command flakes')

if ! command -v curl >/dev/null; then
  echo "Installing curl."
  sudo apt install curl
fi

if ! command -v nix >/dev/null; then
  echo "Installing nix."
  sh <(curl -L https://nixos.org/nix/install) --no-modify-profile
  for profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    if [[ -e "$profile" ]]; then
      # shellcheck source=/dev/null
      source "$profile"
    fi
  done
fi

# Build and run the activation script directly so the first activation uses
# the home-manager version pinned in flake.lock. After this the
# `home-manager` command is installed and the usual update is:
#   home-manager switch --flake ~/repos/dotfiles#<conf>
echo "Activating home-manager configuration: $conf"
activation="$(nix "${nix_args[@]}" build --no-link --print-out-paths \
  "$repo#homeConfigurations.$conf.activationPackage")"
"$activation/activate"

vim +PlugInstall +PlugUpdate +qall

if [[ ! "$SHELL" =~ .*zsh.* ]]; then
  if ! command -v zsh >/dev/null; then
    echo "Installing zsh."
    sudo apt install zsh
  fi
  echo "Changing shell to zsh."
  chsh -s "$(command -v zsh)"
fi
