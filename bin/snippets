#!/bin/bash
#
# Open this weeks snippets file in a new tmux session. Open last week's snippets
# if it's Monday before 3pm.

set -euo pipefail

# Formats the epoch seconds `$1` with the `date` format `$2` using either GNU
# or BSD `date`.
format_epoch() {
  date -d "@$1" "$2" 2>/dev/null || date -r "$1" "$2"
}

now="$(date +%s)"
hour="$(date +%H)"
days_back=$(( $(date +%u) - 1 ))
if (( days_back == 0 && 10#$hour < 15 )); then
  days_back=7
fi
# Anchor on noon so a DST change between now and Monday can't shift the date.
noon=$(( now + (12 - 10#$hour) * 3600 ))
monday=$(( noon - days_back * 86400 ))

# Use the year of the Monday, not today, so early January still finds the
# file from the last week of December.
DIR=~/snippets/"$(format_epoch "$monday" +%Y)"
FILE="$(format_epoch "$monday" +%m-%d.md)"

mkdir -p "$DIR"
if [[ "${1:-}" == "--print" ]]; then
  echo "$DIR/$FILE"
  exit 0
fi
cd "$DIR"
session_finder snippets sh -c "vim \"$FILE\""
