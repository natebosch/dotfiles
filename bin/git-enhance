#!/bin/bash
#
# Configures the current checkout with the enhancements available for its
# repo, and removes enhancements that no longer apply. See git-enhance(1).

set -euo pipefail

usage() {
  echo "usage: git enhance [--force]"
}

force=false
while (( $# > 0 )); do
  case "$1" in
    -f|--force) force=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

dotfiles="${GIT_ENHANCE_DOTFILES:-$HOME/repos/dotfiles}"
skills_root="${GIT_ENHANCE_SKILLS:-$HOME/.vibes/skills/repos}"
repos_root="${GIT_ENHANCE_REPOS:-$HOME/repos}"

marker="# Generated by git-enhance. Changes will be overwritten."

if [[ "$(git rev-parse --is-bare-repository)" == true ]]; then
  echo "git enhance: bare repository, nothing to do." >&2
  exit 0
fi
toplevel="$(git rev-parse --show-toplevel)"

# The repo name is the first path component under `$repos_root` of the main
# checkout. Use the common git dir rather than the top level so linked
# worktrees resolve to their repo wherever they live.
common="$(git rev-parse --path-format=absolute --git-common-dir)"
main="$(dirname "$common")"
name=""
if [[ "$main" == "$repos_root"/* ]]; then
  name="${main#"$repos_root"/}"
  name="${name%%/*}"
fi

failed=false

# Prints a path relative to the top level for messages.
show() {
  echo "${1#"$toplevel"/}"
}

warn() {
  echo "git enhance: $*" >&2
}

# Succeeds if the repo tracks `$1`.
is_tracked() {
  git -C "$toplevel" ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

# Replaces the file `$1` with the content `$2` and a trailing newline.
write_atomic() {
  local target="$1" content="$2" tmp
  mkdir -p "$(dirname "$target")"
  tmp="$(mktemp "$target.XXXXXX")"
  printf '%s\n' "$content" > "$tmp"
  mv "$tmp" "$target"
}

# Brings the file `$1` in line with the content `$3`, or removes it when `$3`
# is empty. `$2` is a command that succeeds when the existing file was
# written by git enhance.
#
# Runs with `set -e` in effect, so unexpected failures abort the command.
reconcile() {
  local target="$1" owned_check="$2" desired="$3"
  if is_tracked "$target"; then
    if [[ -n "$desired" ]]; then
      warn "$(show "$target") is tracked by the repo, leaving it alone."
    fi
    return
  fi
  local owned=false
  if [[ -e "$target" ]] && "$owned_check" "$target"; then
    owned=true
  fi
  if [[ -z "$desired" ]]; then
    if $owned; then
      rm -f "$target"
      echo "Removed $(show "$target")"
    fi
    return
  fi
  if [[ -e "$target" ]] && ! $owned; then
    if ! $force; then
      warn "$(show "$target") was not written by git enhance." \
        "Move its contents into git enhance or rerun with --force to" \
        "replace it."
      failed=true
      return
    fi
    warn "Replacing $(show "$target")."
  fi
  if [[ -f "$target" ]] && [[ "$(cat "$target")" == "$desired" ]]; then
    return
  fi
  write_atomic "$target" "$desired"
  echo "Wrote $(show "$target")"
}

### .envrc for a dev shell from the dotfiles flake.

envrc_owned() {
  [[ "$(head -n 1 "$1")" == "$marker" ]]
}

envrc="$toplevel/.envrc"
envrc_content=""
if [[ -n "$name" && -f "$dotfiles/dev-shells/$name.nix" ]]; then
  # `source_up_if_exists` keeps an `.envrc` above the checkout working, such
  # as the gclient root for dart-sdk.
  envrc_content="$(printf '%s\n' \
    "$marker" \
    "source_up_if_exists" \
    "use flake $dotfiles#$name")"
fi
reconcile "$envrc" envrc_owned "$envrc_content"
if [[ -n "$envrc_content" && -f "$envrc" ]] && envrc_owned "$envrc"; then
  if command -v direnv >/dev/null; then
    direnv allow "$envrc"
  else
    warn "direnv is not installed, $(show "$envrc") will not load."
  fi
fi

### .agents/skills.json for skills under the vibes skills directory.

# Edits the file semantically so it can be shared with hand-written entries.
# Entries that point into the skills directory belong to git enhance. Others,
# and any other keys, are left as they are.
skills_json="$toplevel/.agents/skills.json"
skills_want=""
if [[ -n "$name" && -d "$skills_root/$name" ]]; then
  skills_want="$skills_root/$name"
fi

# Drops entries under the skills directory other than the first one for
# `$want`, then appends `$want` if it isn't there. Existing entries keep their
# position so reruns don't reorder the file.
# shellcheck disable=SC2016 # `$root` and `$want` are jq variables.
skills_filter='
  def ours: (.path? // null) | type == "string" and startswith($root);
  if type != "object" or ((.entries // []) | type) != "array" then
    error("expected an object with an \"entries\" array")
  else . end
  | ((.entries // [])
      | reduce .[] as $entry ([];
          if ($entry | ours | not) then . + [$entry]
          elif $want != "" and $entry.path == $want
            and (any(.[]; (.path? // null) == $want) | not)
          then . + [$entry]
          else . end)
      | if $want != "" and (any(.[]; (.path? // null) == $want) | not)
        then . + [{path: $want}] else . end) as $entries
  | if (.entries // []) == $entries then . else .entries = $entries end
'

update_skills() {
  local target="$skills_json" before after
  if is_tracked "$target"; then
    if [[ -n "$skills_want" ]]; then
      warn "$(show "$target") is tracked by the repo, leaving it alone."
    fi
    return
  fi
  if [[ ! -e "$target" ]]; then
    if [[ -n "$skills_want" ]]; then
      write_atomic "$target" "$(jq -n --arg root "$skills_root/" \
        --arg want "$skills_want" "{} | $skills_filter")"
      echo "Wrote $(show "$target")"
    fi
    return
  fi
  if ! before="$(jq -S . "$target" 2>/dev/null)" ||
      ! after="$(jq --arg root "$skills_root/" --arg want "$skills_want" \
        "$skills_filter" "$target" 2>/dev/null)"; then
    if $force && [[ -n "$skills_want" ]]; then
      warn "Replacing $(show "$target"), which is not a valid skills file."
      write_atomic "$target" "$(jq -n --arg root "$skills_root/" \
        --arg want "$skills_want" "{} | $skills_filter")"
      echo "Wrote $(show "$target")"
    else
      warn "$(show "$target") is not a valid skills file." \
        "Fix it or rerun with --force to replace it."
      failed=true
    fi
    return
  fi
  if [[ "$(jq -S . <<<"$after")" == "$before" ]]; then
    return
  fi
  if [[ "$(jq -c . <<<"$after")" == '{"entries":[]}' ]]; then
    # Nothing is left but our empty list.
    rm -f "$target"
    rmdir "$(dirname "$target")" 2>/dev/null || true
    echo "Removed $(show "$target")"
    return
  fi
  write_atomic "$target" "$after"
  echo "Updated $(show "$target")"
}
update_skills

if $failed; then
  exit 1
fi
