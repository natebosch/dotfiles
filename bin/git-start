#!/bin/bash

set -euo pipefail

if [[ $# -ne 1 || -z "$1" ]]; then
  echo "Usage: git start <name>|-<suffix>|+<name>" >&2
  exit 64
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
# No upstream is an expected state.
upstream_full="$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null)" ||
  upstream_full=""
reset_against=""
if [[ "$branch" == "$(git mainbranch)" && "$upstream_full" == "refs/remotes/"* ]]; then
  upstream="$(git rev-parse --abbrev-ref "$upstream_full")"
  ahead="$(git rev-list --left-only --count "$branch...$upstream")"
  if [[ "$ahead" -ne "0" ]]; then
    reset_against="$upstream"
  fi
fi

name="$1"
if [[ "$name" == -* ]]; then
  name="$branch-${name}"
fi
if [[ "$name" == +* ]]; then
  branch="$(git mainbranch)"
  name="${name:1}"
fi

# With `set -e` a failure here stops before resetting the default branch, the
# new branch must exist to hold the commits being moved.
git checkout "$branch" -b "$name"
git branch -u "$branch"

if [[ -n "$reset_against" ]]; then
  git checkout "$branch"
  git reset --hard "$reset_against"
  git checkout '@{-1}'
fi
