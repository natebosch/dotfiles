#!/bin/bash

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <file>" >&2
  exit 1
fi
FILE="$(readlink -f "$1")"
# Escape for a JSON string.
FILE="${FILE//\\/\\\\}"
FILE="${FILE//\"/\\\"}"

printf '\033]51;["call", "Tapi_EditNested", ["%s"]]\a' "$FILE"
# Wait for vim to send a line when the nested edit is done. Hide the
# response and restore echo even if interrupted.
trap 'stty echo' EXIT
stty -echo
read -r _
